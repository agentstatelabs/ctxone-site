---
/**
 * Blog index — lists non-draft posts, newest first.
 *
 * Every non-draft post is rendered into the page, but each item is
 * tagged with its pubDate and future-dated ones are hidden. A small
 * inline script reconciles visibility against the visitor's current
 * date on load — so the weekly drip happens in the browser, with no
 * scheduled rebuild. `data-count` lets the script swap in the empty
 * state if nothing is live yet.
 */
import LandingLayout from '../../layouts/LandingLayout.astro';
import { getListablePosts } from '../../lib/posts';

const posts = await getListablePosts();
const buildNow = Date.now();

const dateFormatter = new Intl.DateTimeFormat('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<LandingLayout
	title="CTXone Blog"
	description="Writing on agent state, memory for AI tools, and the infrastructure behind CTXone."
>
	<section class="section">
		<div class="container narrow">
			<div class="eyebrow">Blog</div>
			<h1>Notes from the team</h1>
			<p class="lede">
				Writing on agent state, memory for AI tools, and what
				we're learning while building CTXone.
			</p>

			<div class="empty" id="blog-empty" hidden>
				<p>
					No posts yet. Subscribe to know when the first one
					lands.
				</p>
				<a
					class="btn btn-secondary"
					href="https://github.com/AgentStateLabs/CTXone"
					rel="noopener"
				>
					Watch on GitHub
				</a>
			</div>

			<ul class="post-list" id="blog-list">
				{posts.map((post) => (
					<li
						class="post-item"
						data-pubdate={post.data.pubDate.toISOString()}
						hidden={post.data.pubDate.valueOf() > buildNow}
					>
						<a href={`/blog/${post.id}/`} class="post-link">
							<div class="post-meta">
								<time datetime={post.data.pubDate.toISOString()}>
									{dateFormatter.format(post.data.pubDate)}
								</time>
								<span class="dot-sep">·</span>
								<span class="author">{post.data.author}</span>
							</div>
							<h2 class="post-title">{post.data.title}</h2>
							<p class="post-desc">{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	<script is:inline>
		// Client-side drip gate: reveal only posts whose pubDate has
		// arrived, evaluated against the visitor's clock at load time.
		// This is what lets a future-dated post go live on its date with
		// no site rebuild. Draft posts are never shipped, so they can't
		// leak here.
		(function () {
			var now = Date.now();
			var items = document.querySelectorAll('#blog-list .post-item');
			var live = 0;
			items.forEach(function (li) {
				var d = Date.parse(li.getAttribute('data-pubdate'));
				var future = isFinite(d) && d > now;
				li.hidden = future;
				if (!future) live++;
			});
			var empty = document.getElementById('blog-empty');
			var list = document.getElementById('blog-list');
			if (empty) empty.hidden = live !== 0;
			if (list) list.hidden = live === 0;
		})();
	</script>
</LandingLayout>

<style>
	.narrow {
		max-width: 44rem;
	}

	.eyebrow {
		color: var(--ctx-accent);
		font-family: var(--ctx-font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 0.75rem;
	}

	h1 {
		font-size: clamp(1.8rem, 4vw, 2.75rem);
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 1rem 0;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.lede {
		color: var(--ctx-text-dim);
		font-size: 1.1rem;
		margin: 0 0 2.5rem 0;
	}

	.empty {
		border: 1px dashed var(--ctx-border-hi);
		border-radius: var(--ctx-radius-lg);
		padding: 2.5rem 1.5rem;
		text-align: center;
		background: var(--ctx-panel);
	}

	.empty p {
		color: var(--ctx-text-dim);
		font-size: 1rem;
		margin: 0 0 1.25rem 0;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-item {
		border: 1px solid var(--ctx-border);
		border-radius: var(--ctx-radius-lg);
		background: var(--ctx-panel);
		transition: border-color 0.12s, transform 0.12s;
	}

	.post-item:hover {
		border-color: var(--ctx-border-hi);
	}

	.post-link {
		display: block;
		padding: 1.25rem 1.5rem;
		text-decoration: none !important;
		color: inherit;
	}

	.post-link:hover {
		text-decoration: none !important;
	}

	.post-meta {
		color: var(--ctx-text-faint);
		font-family: var(--ctx-font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.5rem;
	}

	.dot-sep {
		margin: 0 0.5rem;
	}

	.post-title {
		color: #ffffff;
		font-size: 1.3rem;
		font-weight: 700;
		margin: 0 0 0.4rem 0;
		letter-spacing: -0.01em;
	}

	.post-desc {
		color: var(--ctx-text-dim);
		font-size: 0.95rem;
		margin: 0;
		line-height: 1.55;
	}
</style>
