---
/**
 * The landing page at ctxone.com/
 *
 * Reworked to position CTXone as the four-surface context engine
 * (memory + plans + branches + taint + provenance), not just a memory
 * layer. Sections: hero, four surfaces, six capabilities, the context
 * -anxiety vignettes, savings showcase, integrations, CTA.
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import HeroV2 from '../components/v2/HeroV2.astro';
import StatsBand from '../components/v2/StatsBand.astro';
import Surfaces from '../components/v2/Surfaces.astro';
import LensShowcase from '../components/LensShowcase.astro';
import Capabilities from '../components/v2/Capabilities.astro';
import PairsWithASD from '../components/v2/PairsWithASD.astro';
import ProblemSection from '../components/ProblemSection.astro';
import SavingsShowcase from '../components/SavingsShowcase.astro';
import IntegrationsRow from '../components/IntegrationsRow.astro';
// Team & Enterprise are not yet available — the Editions section is
// withheld until those tiers ship. Restore this import and <Editions />
// below to bring it back.
// import Editions from '../components/v2/Editions.astro';
import CallToAction from '../components/CallToAction.astro';
---

<LandingLayout
	title="CTXone — the context engine for AI agents"
	description="A self-hosted context engine for AI agents: durable memory that survives sessions, plans that survive plan rot, git-style branches and blame, and provable token savings. MCP-native, zero telemetry."
>
	<HeroV2 />
	<StatsBand />
	<Surfaces />
	<LensShowcase />
	<Capabilities />
	<PairsWithASD />
	<ProblemSection />
	<SavingsShowcase />
	<IntegrationsRow />
	{/* <Editions /> — withheld until Team & Enterprise ship */}
	<CallToAction />
</LandingLayout>
