---
/**
 * Marketing "Why CTXone" pages at /why/:slug — LandingLayout-styled
 * renders of the `why` collection (copies of the docs/why-ctxone
 * essays). Each canonicals to its docs original (/why-ctxone/:slug)
 * so the duplicated content doesn't compete in search.
 */
import { getCollection, render } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('why');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Canonical → the docs original, to avoid duplicate-content penalties.
const canonical = new URL(`/why-ctxone/${entry.id}/`, Astro.site).href;
---

<LandingLayout
	title={`${entry.data.title} — Why CTXone`}
	description={entry.data.description}
	canonical={canonical}
>
	<article class="section">
		<div class="container narrow">
			<div class="eyebrow"><a href="/why/">← Why CTXone</a></div>
			<h1>{entry.data.title}</h1>
			<div class="prose">
				<Content />
			</div>
			<p class="more">
				<a href="/why/">All Why-CTXone pages</a>
				&nbsp;·&nbsp;
				<a href="/getting-started/quickstart/">Get started →</a>
			</p>
		</div>
	</article>
</LandingLayout>

<style>
	.narrow {
		max-width: 44rem;
	}

	.eyebrow {
		font-family: var(--ctx-font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
	}

	.eyebrow a {
		color: var(--ctx-accent);
	}

	h1 {
		font-size: clamp(1.8rem, 4vw, 2.75rem);
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 1.5rem 0;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.prose {
		color: var(--ctx-text);
		font-size: 1rem;
		line-height: 1.75;
	}

	.prose :global(h2) {
		color: #ffffff;
		font-size: 1.5rem;
		margin: 2.5rem 0 1rem 0;
		letter-spacing: -0.01em;
	}

	.prose :global(h3) {
		color: #ffffff;
		font-size: 1.15rem;
		margin: 2rem 0 0.75rem 0;
	}

	.prose :global(p) {
		margin: 0 0 1.1rem 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.1rem 0;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(a) {
		color: var(--ctx-accent);
	}

	.prose :global(strong) {
		color: #ffffff;
	}

	.prose :global(code) {
		background: var(--ctx-panel);
		border: 1px solid var(--ctx-border);
		padding: 0.1rem 0.4rem;
		border-radius: var(--ctx-radius-sm);
		font-size: 0.9em;
		color: var(--ctx-accent-text);
		font-family: var(--ctx-font-mono);
	}

	.prose :global(pre) {
		background: #0a0a0a;
		border: 1px solid var(--ctx-border);
		border-radius: var(--ctx-radius-md);
		padding: 1rem 1.25rem;
		overflow-x: auto;
		font-size: 0.85rem;
		margin: 1.5rem 0;
	}

	.prose :global(pre code) {
		background: transparent;
		border: none;
		padding: 0;
		color: var(--ctx-text-code);
	}

	.prose :global(blockquote) {
		border-left: 3px solid var(--ctx-accent);
		padding-left: 1rem;
		color: var(--ctx-text-dim);
		margin: 1.5rem 0;
		font-style: italic;
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
		font-size: 0.9rem;
	}

	.prose :global(th),
	.prose :global(td) {
		border: 1px solid var(--ctx-border);
		padding: 0.5rem 0.75rem;
		text-align: left;
	}

	.prose :global(th) {
		background: var(--ctx-panel);
		color: #ffffff;
	}

	.more {
		color: var(--ctx-text-dim);
		font-size: 0.9rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--ctx-border);
	}
</style>
