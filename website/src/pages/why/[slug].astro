---
/**
 * Marketing "Why CTXone" pages at /why/:slug — designed as SITE pages,
 * not docs. LandingLayout chrome + a hero band + a styled content
 * column that renders the single-source markdown (from the `why`
 * collection, which reads the docs/why-ctxone files). Docs artifacts
 * (Starlight heading anchors) are hidden so it doesn't read as a doc.
 *
 * "Use cases" is intentionally excluded here — it lives at /use-cases.
 * Each page canonicals to its docs original to avoid duplicate content.
 */
import { getCollection, render } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import { accentFor } from '../../lib/why-accents';

export async function getStaticPaths() {
	const entries = (await getCollection('why')).filter(
		(e) => e.id !== 'use-cases'
	);
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const accent = accentFor(entry.id);
const canonical = new URL(`/why-ctxone/${entry.id}/`, Astro.site).href;
---

<LandingLayout
	title={`${entry.data.title} — Why CTXone`}
	description={entry.data.description}
	canonical={canonical}
>
	<section class={`hero hero-gradient a-${accent}`}>
		<div class="container">
			<div class="eyebrow">
				<span class="dot"></span>
				<span>CTXONE // why</span>
			</div>
			<h1>{entry.data.title}</h1>
			{entry.data.description && <p class="lede">{entry.data.description}</p>}
		</div>
	</section>

	<section class="body-section">
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container">
			<a class="link" href="/why/">← All Why-CTXone pages</a>
			<a class="btn btn-primary" href="/getting-started/quickstart/">Get started →</a>
		</div>
	</section>
</LandingLayout>

<style>
	.container {
		max-width: 46rem;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* Accent theming — set per topic so the page matches its index card. */
	.a-blue  { --a: var(--ctx-accent);  --a-rgb: 59, 130, 246; --a-text: var(--ctx-accent-text); }
	.a-green { --a: var(--ctx-success); --a-rgb: 34, 197, 94;  --a-text: #86efac; }
	.a-amber { --a: var(--ctx-warn);    --a-rgb: 252, 211, 77; --a-text: var(--ctx-warn); }

	.hero {
		padding: 4.5rem 0 2rem 0;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.8rem;
		background: rgba(var(--a-rgb), 0.08);
		border: 1px solid rgba(var(--a-rgb), 0.28);
		border-radius: 999px;
		font-family: var(--ctx-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		color: var(--a-text);
		margin-bottom: 1.25rem;
		font-weight: 700;
	}

	.eyebrow .dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--a);
		box-shadow: 0 0 10px rgba(var(--a-rgb), 0.8);
	}

	h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		font-weight: 800;
		color: #ffffff;
		margin: 0 0 1rem 0;
		line-height: 1.1;
		letter-spacing: -0.025em;
	}

	.lede {
		font-size: 1.2rem;
		color: var(--ctx-text-dim);
		line-height: 1.6;
		margin: 0;
		max-width: 40rem;
	}

	.body-section {
		padding: 1.5rem 0 3rem 0;
	}

	.prose {
		color: var(--ctx-text);
		font-size: 1.05rem;
		line-height: 1.8;
	}

	/* Kill docs artifacts so this reads as a site page, not a doc. */
	.prose :global(.sl-anchor-link) {
		display: none;
	}

	.prose :global(h2) {
		color: #ffffff;
		font-size: 1.6rem;
		margin: 2.75rem 0 1rem 0;
		letter-spacing: -0.01em;
		padding-top: 1.5rem;
		border-top: 1px solid var(--ctx-border-lo);
	}

	.prose :global(h2:first-of-type) {
		border-top: none;
		padding-top: 0;
		margin-top: 1rem;
	}

	.prose :global(h3) {
		color: #ffffff;
		font-size: 1.2rem;
		margin: 2rem 0 0.75rem 0;
	}

	.prose :global(p) {
		margin: 0 0 1.15rem 0;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1.15rem 0;
		padding-left: 1.5rem;
	}

	.prose :global(li) {
		margin-bottom: 0.5rem;
	}

	.prose :global(a) {
		color: var(--ctx-accent);
	}

	.prose :global(strong) {
		color: #ffffff;
	}

	.prose :global(code) {
		background: var(--ctx-panel);
		border: 1px solid var(--ctx-border);
		padding: 0.1rem 0.4rem;
		border-radius: var(--ctx-radius-sm);
		font-size: 0.9em;
		color: var(--ctx-accent-text);
		font-family: var(--ctx-font-mono);
	}

	.prose :global(pre) {
		background: #0a0a0a;
		border: 1px solid var(--ctx-border);
		border-radius: var(--ctx-radius-md);
		padding: 1rem 1.25rem;
		overflow-x: auto;
		font-size: 0.85rem;
		margin: 1.5rem 0;
	}

	.prose :global(pre code) {
		background: transparent;
		border: none;
		padding: 0;
		color: var(--ctx-text-code);
	}

	.prose :global(blockquote) {
		border-left: 3px solid var(--ctx-accent);
		padding: 0.5rem 0 0.5rem 1.1rem;
		color: var(--ctx-text-dim);
		margin: 1.5rem 0;
		background: rgba(59, 130, 246, 0.04);
		border-radius: 0 var(--ctx-radius-sm) var(--ctx-radius-sm) 0;
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
		font-size: 0.92rem;
	}

	.prose :global(th),
	.prose :global(td) {
		border: 1px solid var(--ctx-border);
		padding: 0.55rem 0.8rem;
		text-align: left;
	}

	.prose :global(th) {
		background: var(--ctx-panel);
		color: #ffffff;
	}

	.cta {
		padding: 2rem 0 4rem 0;
		border-top: 1px solid var(--ctx-border-lo);
	}

	.cta .container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.link {
		color: var(--ctx-text-dim);
		font-size: 0.9rem;
	}
</style>
