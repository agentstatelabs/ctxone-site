---
/**
 * Lens screenshot showcase for the landing page. A hub-overview hero plus a
 * three-up grid (workspace / code / sessions) so visitors can see the web UI
 * before installing. Images live in website/public/img and are served at /img.
 */
type Shot = { src: string; title: string; body: string };

const shots: Shot[] = [
	{
		src: '/img/lens-workspace.png',
		title: 'Workspace dashboard',
		body: 'Import stats, recall savings, and LLM usage costed per model from the exact per-turn token split.',
	},
	{
		src: '/img/lens-code.png',
		title: 'Code intelligence',
		body: 'Symbols, files, and call graphs indexed per repo through AgentStateDeveloper.',
	},
	{
		src: '/img/lens-sessions.png',
		title: 'Sessions',
		body: 'Every ingested transcript, filterable by agent and model, each with its token spend and savings.',
	},
];
---

<section id="lens" class="section lens">
	<div class="container">
		<div class="eyebrow"><span class="eyebrow-text">LENS // web UI</span></div>
		<h2 class="section-title">See the whole record.</h2>
		<p class="section-lede">
			Lens is the web UI over everything the Hub records — workspaces,
			sessions, code intelligence, and memory, with per-model token and
			cost accounting throughout.
		</p>

		<a class="hero-shot" href="/img/lens-hub.png">
			<img
				src="/img/lens-hub.png"
				alt="CTXone Lens — Hub overview: every workspace with its sessions, token totals, and per-model cost"
				width="1440"
				height="900"
				loading="lazy"
				decoding="async"
			/>
		</a>

		<div class="grid">
			{
				shots.map((s) => (
					<figure class="shot">
						<a href={s.src}>
							<img src={s.src} alt={s.title} loading="lazy" decoding="async" />
						</a>
						<figcaption>
							<strong>{s.title}</strong> — {s.body}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<style>
	.lens {
		background:
			radial-gradient(ellipse 50% 40% at 80% 0%, rgba(251, 191, 36, 0.05), transparent 60%),
			var(--ctx-bg);
	}

	.hero-shot {
		display: block;
		max-width: 1100px;
		margin: 2.5rem auto 0;
	}

	.hero-shot img,
	.shot img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--ctx-border);
		border-radius: var(--ctx-radius-lg, 12px);
	}

	.hero-shot img {
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.75rem;
		margin-top: 2.5rem;
	}

	.shot {
		margin: 0;
	}

	.shot figcaption {
		margin-top: 0.85rem;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--ctx-text-dim);
	}

	.shot figcaption strong {
		color: var(--ctx-text);
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
