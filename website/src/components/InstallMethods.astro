---
/**
 * Installer block, three parts:
 *
 *   1. Featured "agent" call-out — the paste-into-your-agent path
 *      (`ctx bootstrap`), highlighted as the fastest way in.
 *   2. Platform installers as tabs — Homebrew, Shell, Windows.
 *   3. A platform-support strip — macOS (Apple Silicon + Intel),
 *      Linux, Windows.
 *
 * Self-contained: a tiny inline script handles tab switching and
 * clipboard copy — no framework.
 */

type Method = {
	id: string;
	label: string;
	hint?: string;
	cmd: string;
};

const agentCmd = 'ctx bootstrap';
const agentCaption =
	'Prints a block you paste into whatever agent you’re already in — it installs and primes CTXone, and offers to set up AgentStateDeveloper too.';

const methods: Method[] = [
	{ id: 'brew', label: 'Homebrew', hint: 'macOS', cmd: 'brew tap agentstatelabs/ctxone && brew install ctxone' },
	{ id: 'shell', label: 'Shell', hint: 'macOS · Linux', cmd: 'curl -sSL https://raw.githubusercontent.com/AgentStateLabs/CTXone/main/install.sh | sh' },
	{ id: 'windows', label: 'Windows', hint: 'PowerShell', cmd: 'iwr https://raw.githubusercontent.com/AgentStateLabs/CTXone/main/install.ps1 | iex' },
];

const platforms = ['macOS · Apple Silicon', 'macOS · Intel', 'Linux', 'Windows'];
---

<div class="install-methods">
	<!-- Featured: let your agent install it -->
	<div class="agent-callout">
		<div class="agent-head">
			<span class="spark" aria-hidden="true">⚡</span>
			<span class="agent-title">Let your agent install it</span>
			<span class="agent-badge">fastest</span>
		</div>
		<div class="cmd" data-copy={agentCmd}>
			<code class="cmd-text">
				<span class="prompt">$</span>
				<span class="text">{agentCmd}</span>
			</code>
			<button type="button" class="copy-btn" aria-label="Copy agent install command">
				<span class="copy-label">Copy</span>
			</button>
		</div>
		<p class="cmd-note">{agentCaption}</p>
	</div>

	<div class="or">or install directly</div>

	<!-- Platform installers -->
	<div class="tabs" role="tablist" aria-label="Install method">
		{methods.map((m, i) => (
			<button
				type="button"
				class:list={['tab', { active: i === 0 }]}
				role="tab"
				aria-selected={i === 0 ? 'true' : 'false'}
				data-tab={m.id}
			>
				{m.label}
				{m.hint && <span class="tab-hint">{m.hint}</span>}
			</button>
		))}
	</div>

	{methods.map((m, i) => (
		<div class:list={['panel', { active: i === 0 }]} data-panel={m.id} hidden={i !== 0}>
			<div class="cmd" data-copy={m.cmd}>
				<code class="cmd-text">
					<span class="prompt">$</span>
					<span class="text">{m.cmd}</span>
				</code>
				<button type="button" class="copy-btn" aria-label={`Copy ${m.label} install`}>
					<span class="copy-label">Copy</span>
				</button>
			</div>
		</div>
	))}

	<!-- Platform support strip -->
	<div class="platforms" aria-label="Supported platforms">
		<span class="platforms-label">Runs on</span>
		{platforms.map((p) => <span class="platform">{p}</span>)}
	</div>
</div>

<script>
	// Tab switching + clipboard copy. No framework.
	document.querySelectorAll<HTMLElement>('.install-methods').forEach((root) => {
		const tabs = root.querySelectorAll<HTMLButtonElement>('.tab');
		const panels = root.querySelectorAll<HTMLElement>('.panel');

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const id = tab.dataset.tab;
				tabs.forEach((t) => {
					const on = t === tab;
					t.classList.toggle('active', on);
					t.setAttribute('aria-selected', on ? 'true' : 'false');
				});
				panels.forEach((p) => {
					const on = p.dataset.panel === id;
					p.classList.toggle('active', on);
					p.hidden = !on;
				});
			});
		});

		root.querySelectorAll<HTMLElement>('.cmd').forEach((el) => {
			const btn = el.querySelector<HTMLButtonElement>('.copy-btn');
			const label = btn?.querySelector<HTMLSpanElement>('.copy-label');
			const text = el.dataset.copy ?? '';
			if (!btn || !label) return;
			btn.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(text);
					const original = label.textContent ?? 'Copy';
					label.textContent = 'Copied ✓';
					btn.classList.add('copied');
					setTimeout(() => {
						label.textContent = original;
						btn.classList.remove('copied');
					}, 1500);
				} catch (err) {
					console.error('[ctxone] clipboard copy failed:', err);
				}
			});
		});
	});
</script>

<style>
	.install-methods {
		max-width: 40rem;
	}

	/* --- Featured agent call-out --- */
	.agent-callout {
		background:
			radial-gradient(ellipse 80% 120% at 0% 0%, rgba(59, 130, 246, 0.1), transparent 60%),
			var(--ctx-panel);
		border: 1px solid var(--ctx-accent);
		border-radius: var(--ctx-radius-lg);
		padding: 1rem 1.1rem 1.1rem;
		box-shadow: 0 0 24px rgba(59, 130, 246, 0.08);
	}

	.agent-head {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.7rem;
	}

	.spark {
		font-size: 0.95rem;
		filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.6));
	}

	.agent-title {
		color: #ffffff;
		font-weight: 700;
		font-size: 0.98rem;
	}

	.agent-badge {
		font-family: var(--ctx-font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ctx-accent-text);
		background: rgba(59, 130, 246, 0.14);
		border: 1px solid rgba(59, 130, 246, 0.4);
		border-radius: 999px;
		padding: 0.15rem 0.5rem;
	}

	.or {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 1.1rem 0 0.9rem;
		color: var(--ctx-text-faint);
		font-family: var(--ctx-font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.or::before,
	.or::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--ctx-border);
	}

	/* --- Platform tabs --- */
	.tabs {
		display: flex;
		gap: 0.35rem;
		margin-bottom: 0.6rem;
		flex-wrap: wrap;
	}

	.tab {
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		background: transparent;
		border: 1px solid var(--ctx-border);
		border-radius: 999px;
		padding: 0.4rem 0.9rem;
		font-family: var(--ctx-font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ctx-text-dim);
		cursor: pointer;
		transition: color 0.12s, border-color 0.12s, background 0.12s;
	}

	.tab:hover {
		color: #ffffff;
		border-color: var(--ctx-border-hi);
	}

	.tab.active {
		color: #ffffff;
		border-color: var(--ctx-accent);
		background: rgba(59, 130, 246, 0.1);
	}

	.tab-hint {
		font-size: 0.62rem;
		font-weight: 500;
		color: var(--ctx-text-faint);
		letter-spacing: 0.02em;
	}

	.tab.active .tab-hint {
		color: var(--ctx-accent-text);
	}

	/* --- Command box (shared) --- */
	.cmd {
		display: flex;
		align-items: stretch;
		background: var(--ctx-bg);
		border: 1px solid var(--ctx-border-hi);
		border-radius: var(--ctx-radius-md);
		overflow: hidden;
		font-family: var(--ctx-font-mono);
	}

	.agent-callout .cmd {
		background: var(--ctx-bg);
	}

	.cmd-text {
		flex: 1;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1rem;
		font-size: 0.85rem;
		color: var(--ctx-text);
		overflow-x: auto;
		font-family: inherit;
		line-height: 1.5;
		white-space: nowrap;
	}

	.prompt {
		color: var(--ctx-accent);
		user-select: none;
		flex-shrink: 0;
	}

	.text {
		flex: 1;
	}

	.copy-btn {
		background: var(--ctx-panel-hi);
		border: none;
		border-left: 1px solid var(--ctx-border-hi);
		color: var(--ctx-text-dim);
		padding: 0 1.1rem;
		font-size: 0.75rem;
		font-family: var(--ctx-font-mono);
		font-weight: 600;
		cursor: pointer;
		transition: color 0.12s, background 0.12s;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		flex-shrink: 0;
	}

	.copy-btn:hover {
		color: #ffffff;
		background: var(--ctx-border);
	}

	.copy-btn.copied {
		color: var(--ctx-success);
	}

	.cmd-note {
		margin: 0.55rem 0 0 0;
		font-size: 0.8rem;
		line-height: 1.5;
		color: var(--ctx-text-dim);
	}

	/* --- Platform support strip --- */
	.platforms {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1rem;
	}

	.platforms-label {
		font-size: 0.72rem;
		color: var(--ctx-text-faint);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-family: var(--ctx-font-mono);
		margin-right: 0.15rem;
	}

	.platform {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.6rem;
		background: rgba(17, 17, 17, 0.6);
		border: 1px solid var(--ctx-border);
		border-radius: 999px;
		font-size: 0.7rem;
		color: var(--ctx-text-dim);
		font-family: var(--ctx-font-mono);
	}
</style>
